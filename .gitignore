# ---- Build output & dependencies (regenerated by npm install / npx rbxtsc) ----
/node_modules
/out
/include
*.tsbuildinfo

# ---- Machine-specific config (template: workspace.local.example.json, see SETUP.md) ----
/workspace.local.json
.env
.env.*
!.env.example

# ---- Claude Code: personal settings of this machine (.claude/settings.json stays shared) ----
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# ---- Editors: only the shared VS Code settings are versioned ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.code-workspace
.idea/

# ---- Roblox Studio / Rojo local files ----
# The place lives on Roblox (published game); local copies and Studio's lock / backup files stay out of git.
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
*.rbxm.lock
sourcemap.json

# ---- Tool scratch output (re-creatable) ----
/tools/icons/
/tools/textures/
/design/ui/redesign-v2.json
/design/ui/admin-panel.json
/design/ui/passes/_sheet.png
npm-debug.log*

# ---- OS clutter ----
.DS_Store
Thumbs.db
desktop.ini

# Exported OBJ sources of the animated meshes (big; the manifest is kept)
/design/meshes/*.obj
/design/ui/sound/_sheet.png
